{
  "name": "iac-k8s-bootstrap",

  // Ubuntu 24.04 base image (via a thin Dockerfile that renames the default
  // non-root user to "jonathan"). The base ships the "common utils" the
  // Dockerfile installed by hand: a sudo user, git, curl, wget, vim, unzip,
  // gnupg, ca-certificates, bash-completion, less, etc.
  //
  // cacheFrom pulls the prebuilt image published by .github/workflows/
  // devcontainer-prebuild.yml, so `devpod up` reuses those layers instead of
  // rebuilding Features locally (fast + avoids flaky local downloads). To skip
  // building entirely, launch with: devpod up <dir> --devcontainer-image
  //   ghcr.io/jonathanmanton/iac-devcontainer:latest
  "build": {
    "dockerfile": "Dockerfile",
    "cacheFrom": "ghcr.io/jonathanmanton/iac-devcontainer:latest"
  },

  // Each tool the Dockerfile installed by hand becomes a Feature.
  "features": {
    // Terraform.
    "ghcr.io/devcontainers/features/terraform:1": {},

    // AWS CLI v2.
//    "ghcr.io/devcontainers/features/aws-cli:1": {},
//
    // kubectl + Helm (Helm 4). minikube skipped - not in the Dockerfile.
    // "latest" resolves to Helm 4.x.
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "latest",
      "minikube": "none"
    },

    // Python (uv/jinja2-cli are installed via brew/uv in postCreate.sh).
    "ghcr.io/devcontainers/features/python:1": {
      "version": "os-provided",
      "installTools": false
    },

    // Node.js + npm.
    "ghcr.io/devcontainers/features/node:1": {},

    // Docker engine running inside the container (Docker-in-Docker).
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  // Toolchain install. Runs as onCreateCommand (not postCreate) so the
  // devcontainer *prebuild* bakes it into the published image — new containers
  // then come up via pull + run, with no heavy install per container.
  "onCreateCommand": "bash .devcontainer/onCreate.sh",

  // Run as the renamed non-root user (uid/gid 1000, from the Dockerfile).
  "remoteUser": "jonathan"
}
