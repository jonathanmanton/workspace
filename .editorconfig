# EditorConfig (https://editorconfig.org) — reinforces .gitattributes at the
# editor level so saved files keep the right line endings/whitespace.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Shell scripts must stay LF — CRLF breaks bash inside the Linux container.
[*.sh]
end_of_line = lf

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
